# ============================================================================
# LLM CONTENT GENERATOR - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control
# ============================================================================

# ----------------------------------------------------------------------------
# GROQ API CONFIGURATION (Primary LLM Provider - Essential Level)
# ----------------------------------------------------------------------------
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=<YOUR_GROQ_API_KEY>
# Available models: llama-3.3-70b-versatile, llama-3.1-70b-versatile
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# ----------------------------------------------------------------------------
# OLLAMA CONFIGURATION (Local LLM Provider - Optional)
# ----------------------------------------------------------------------------
# Base URL for Ollama server (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
# Model to use with Ollama (default: llama3.2)
# Pull models with: ollama pull <model_name>
OLLAMA_MODEL_NAME=llama3

# ----------------------------------------------------------------------------
# HUGGING FACE IMAGE GENERATION (AI-powered image creation)
# ----------------------------------------------------------------------------
# API token for Hugging Face Inference API
# Get your token from: https://huggingface.co/settings/tokens
HF_API_TOKEN=<YOUR_HF_API_TOKEN>
# Image generation model to use
# Recommended models (check availability at https://huggingface.co/models?pipeline_tag=text-to-image):
#   - stabilityai/stable-diffusion-xl-base-1.0 (high quality, default)
#   - runwayml/stable-diffusion-v1-5 (classic, fast)
#   - CompVis/stable-diffusion-v1-4 (original SD)
HF_IMAGE_MODEL=<YOUR_HF_MODEL>

# ----------------------------------------------------------------------------
# EXTERNAL IMAGE SOURCES (Stock photo APIs)
# ----------------------------------------------------------------------------
# Unsplash API access key for high-quality stock photos
# Get your key from: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=<YOUR_UNSPLASH_ACCESS_KEY>

# Pexels API key for stock photo search
# Get your key from: https://www.pexels.com/api/
PEXELS_API_KEY=<YOUR_PEXELS_API_KEY>

# ----------------------------------------------------------------------------
# GOOGLE GEMINI CONFIGURATION (Future Implementation)
# ----------------------------------------------------------------------------
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_MODEL=<YOUR_GEMINI_MODEL>

# ----------------------------------------------------------------------------
# REPLICATE CONFIGURATION (AI Image Generation)
# ----------------------------------------------------------------------------
# Get your API token from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=<YOUR_REPLICATE_API_TOKEN>
# Image generation model (optional - defaults to Stable Diffusion XL)
# Recommended models:
#   - stability-ai/sdxl:39ed52f2a78e934b3ba6e2a89f5b1c712de7dfea535525255b1aa35c5565e08b (default, high quality)
#   - stability-ai/stable-diffusion (classic SD 2.1)
REPLICATE_IMAGE_MODEL=stability-ai/sdxl:39ed52f2a78e934b3ba6e2a89f5b1c712de7dfea535525255b1aa35c5565e08b

# ----------------------------------------------------------------------------
# LANGCHAIN CONFIGURATION (Future Implementation - Observability)
# ----------------------------------------------------------------------------
# Get your API key from: https://smith.langchain.com/
# Enable tracing: set to true to enable LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=<YOUR_LANGCHAIN_API_KEY>
# Project name for organizing traces in LangSmith
LANGCHAIN_PROJECT=llm-content-generator
# LangChain API endpoint
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ----------------------------------------------------------------------------
# RAG CONFIGURATION (Retrieval-Augmented Generation)
# ----------------------------------------------------------------------------
# Text splitting configuration
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# Embedding model (HuggingFace sentence-transformers)
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB vector store configuration
RAG_CHROMA_DIR=app/storage/chroma
RAG_CHROMA_COLLECTION=scientific_rag

# Retriever configuration
RAG_SEARCH_TYPE=similarity
RAG_RETRIEVER_K=4

# ArXiv loader configuration
RAG_ARXIV_MAX_DOCS=5

# ----------------------------------------------------------------------------
# APPLICATION CONFIGURATION (Optional)
# ----------------------------------------------------------------------------
# Default temperature for text generation (0.0 - 1.0)
DEFAULT_TEMPERATURE=0.7
# Maximum tokens to generate
DEFAULT_MAX_TOKENS=2048
